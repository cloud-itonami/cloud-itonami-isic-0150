(deftest hard-violations-op-not-allowed
  (testing "Hard violation: op outside the closed allowlist"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :dispatch-robot-arm :effect :propose}
          verdict (gov/check req nil prop s)]
      (is (:hard? verdict))
      (is (some #(= :op-not-allowed (:rule %)) (:violations verdict))))))

(deftest hard-violations-yield-invalid
  (testing "Hard violation: non-positive crop yield"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :log-farm-record :effect :propose :yield 0 :confidence 0.9}
          verdict (gov/check req nil prop s)]
      (is (:hard? verdict))
      (is (some #(= :farm-record-invalid (:rule %)) (:violations verdict))))))

(deftest hard-violations-herd-count-invalid
  (testing "Hard violation: non-positive herd count"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :log-farm-record :effect :propose :count 0 :confidence 0.9}
          verdict (gov/check req nil prop s)]
      (is (:hard? verdict))
      (is (some #(= :farm-record-invalid (:rule %)) (:violations verdict))))))

(deftest hard-violations-mixed-record-one-side-invalid
  (testing "Hard violation: valid herd count does NOT mask an invalid (non-positive) yield"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :log-farm-record :effect :propose :yield -1 :count 30 :confidence 0.9}
          verdict (gov/check req nil prop s)]
      (is (:hard? verdict))
      (is (some #(= :farm-record-invalid (:rule %)) (:violations verdict)))))

  (testing "Hard violation: valid yield does NOT mask an invalid (non-positive) herd count"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :log-farm-record :effect :propose :yield 12.5 :count -2 :confidence 0.9}
          verdict (gov/check req nil prop s)]
      (is (:hard? verdict))
      (is (some #(= :farm-record-invalid (:rule %)) (:violations verdict))))))

(deftest ok-crop-only-logging
  (testing "OK: crop-only farm record logging (no herd count present) with a registered farm"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :log-farm-record :effect :propose :yield 12.5 :confidence 0.9}
          verdict (gov/check req nil prop s)]
      (is (:ok? verdict))
      (is (not (:hard? verdict)))
      (is (not (:escalate? verdict))))))

(deftest ok-herd-only-logging
  (testing "OK: herd-only farm record logging (no crop yield present) with a registered farm"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :log-farm-record :effect :propose :count 30 :confidence 0.9}
          verdict (gov/check req nil prop s)]
      (is (:ok? verdict))
      (is (not (:hard? verdict)))
      (is (not (:escalate? verdict))))))

(deftest ok-mixed-logging
  (testing "OK: a single record carries BOTH a valid crop yield and a valid herd count"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :log-farm-record :effect :propose :yield 12.5 :count 30 :confidence 0.9}
          verdict (gov/check req nil prop s)]
      (is (:ok? verdict))
      (is (not (:hard? verdict)))
      (is (not (:escalate? verdict))))))

(deftest ok-health-status-only-logging
  (testing "OK: a health-status-only note (neither yield nor count present) is not a record-invalid violation"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :log-farm-record :effect :propose :confidence 0.9}
          verdict (gov/check req nil prop s)]
      (is (:ok? verdict))
      (is (not (:hard? verdict))))))

(deftest escalation-health-concern
  (testing "Escalation: crop or animal health/welfare concern ALWAYS escalates, even at high confidence"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :flag-health-concern :effect :propose
                :concern "疫病の可能性" :confidence 0.95}
          verdict (gov/check req nil prop s)]
      (is (not (:hard? verdict)))
      (is (:escalate? verdict))
      (is (:high-stakes? verdict)))))

(deftest escalation-low-confidence
  (testing "Escalation: confidence below the floor"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :log-farm-record :effect :propose :count 30 :confidence 0.5}
          verdict (gov/check req nil prop s)]
      (is (not (:hard? verdict)))
      (is (:escalate? verdict)))))

(deftest escalation-supply-order-high-cost
  (testing "Escalation: supply order over the (default) cost threshold"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :order-supplies :effect :propose :cost 1000 :confidence 0.9}
          verdict (gov/check req nil prop s)]
      (is (not (:hard? verdict)))
      (is (:escalate? verdict)))))

(deftest escalation-supply-order-category-specific-threshold
  (testing "Escalation: supply order over its category-specific threshold (equipment: 1000)"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :order-supplies :effect :propose :cost 1200 :confidence 0.9
                :value {:category "equipment"}}
          verdict (gov/check req nil prop s)]
      (is (:escalate? verdict))))

  (testing "OK: equipment order under its higher category threshold"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :order-supplies :effect :propose :cost 800 :confidence 0.9
                :value {:category "equipment"}}
          verdict (gov/check req nil prop s)]
      (is (:ok? verdict))
      (is (not (:escalate? verdict))))))

(deftest ok-supply-order-low-cost
  (testing "OK: supply order under the cost threshold"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :order-supplies :effect :propose :cost 100 :confidence 0.9}
          verdict (gov/check req nil prop s)]
      (is (:ok? verdict))
      (is (not (:escalate? verdict))))))

(deftest ok-schedule-farm-operation
  (testing "OK: scheduling a farm operation (field task or veterinary visit) is a routine coordination op"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :schedule-farm-operation :effect :propose :confidence 0.85}
          verdict (gov/check req nil prop s)]
      (is (:ok? verdict))
      (is (not (:escalate? verdict))))))
