(ns mixedfarmops.governor-test
  (:require [kotoba.test :refer [deftest is testing]]
            [mixedfarmops.governor :as gov]
            [mixedfarmops.store :as store]))

(deftest hard-violations-no-farm-id
  (testing "Hard violation: missing farm-id"
    (let [req {}
          prop {:op :log-farm-record :effect :propose}
          s (store/mem-store)
          verdict (gov/check req nil prop s)]
      (is (:hard? verdict))
      (is (seq (:violations verdict)))
      (is (some #(= :farm-not-registered (:rule %)) (:violations verdict))))))

(deftest hard-violations-unregistered-farm
  (testing "Hard violation: farm-id present but not registered"
    (let [req {:farm-id "farm-001"}
          prop {:op :log-farm-record :effect :propose}
          s (store/mem-store)
          verdict (gov/check req nil prop s)]
      (is (:hard? verdict))
      (is (some #(= :farm-not-registered (:rule %)) (:violations verdict))))))

(deftest hard-violations-effect-not-propose
  (testing "Hard violation: effect is not :propose"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :log-farm-record :effect :execute}
          verdict (gov/check req nil prop s)]
      (is (:hard? verdict))
      (is (some #(= :no-execution (:rule %)) (:violations verdict))))))

(deftest hard-violations-field-equipment-blocked
  (testing "Hard violation: direct field-equipment operation is permanently blocked"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :operate-field-equipment :effect :propose}
          verdict (gov/check req nil prop s)]
      (is (:hard? verdict))
      (is (some #(= :equipment-pesticide-or-slaughter-blocked (:rule %)) (:violations verdict))))))

(deftest hard-violations-animal-handling-equipment-blocked
  (testing "Hard violation: direct animal-handling equipment operation is permanently blocked"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
          s (store/mem-store {:initial-farms {"farm-001" farm}})
          req {:farm-id "farm-001"}
          prop {:op :operate-animal-handling-equipment :effect :propose}
          verdict (gov/check req nil prop s)]
      (is (:hard? verdict))
      (is (some #(= :equipment-pesticide-or-slaughter-blocked (:rule %)) (:violations verdict))))))

(deftest hard-violations-pesticide-blocked
  (testing "Hard violation: finalizing a pesticide-application decision is permanently blocked"
    (let [farm {:id "farm-001" :name "Test Mixed Farm"}
